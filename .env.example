# Токен бота от @BotFather (обязательно)
OZON_BOT_TOKEN=123456:ABC-DEF...

# 1 = демо-режим (не ходит в сеть) | 0 = реальный API Ozon
OZON_DEMO_MODE=1

# --- Антибот ---
# curl_cffi (имитация Chrome, по умолчанию) | httpx
OZON_HTTP_CLIENT=curl_cffi
# Прокси с валидным region-cookie: http://user:pass@host:port или socks5://host:1080
OZON_PROXY=
OZON_MAX_RETRIES=3

# --- Продвинутые настройки ---
# Проверка цен раз в N минут (Ozon меняет цены чаще WB)
OZON_CHECK_INTERVAL_MINUTES=360
# Кулдаун уведомлений по одному товару (часы)
OZON_ALERT_COOLDOWN_HOURS=6
# Хранить историю цен N дней
OZON_HISTORY_KEEP_DAYS=30
# Остаток <= порога считается «заканчивается»
OZON_LOW_STOCK_THRESHOLD=5
# Минимальный интервал между сообщениями пользователя (секунды)
OZON_THROTTLE_MIN_INTERVAL=0.7
# ID администраторов для /cleanup (через запятую; пусто = доступно всем)
OZON_ADMIN_IDS=
# TTL кэша карточек Ozon (секунды)
OZON_CACHE_TTL_SECONDS=300
